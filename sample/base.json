{
    "description": "Cmd/Ctrl/Opt swap + IME. Remote(Splashtop+Parallels): Ctrl->Ctrl, Opt->Alt, Cmd held=Ctrl(lazy) / tapped=Home(IMEoff)/End(IMEon). No Win key is sent. Others(local Mac): legacy swap + eisuu/kana.",
    "manipulators": [
        {
            "conditions": [
                {
                    "bundle_identifiers": [
                        "^com\\.splashtop\\.stb\\.macosx$",
                        "^com\\.parallels\\.desktop",
                        "^com\\.parallels\\.vm",
                        "^com\\.parallels\\.winapp\\."
                    ],
                    "type": "frontmost_application_if"
                }
            ],
            "from": {
                "key_code": "left_control",
                "modifiers": { "optional": ["any"] }
            },
            "to": [{ "key_code": "left_control" }],
            "type": "basic"
        },
        {
            "conditions": [
                {
                    "bundle_identifiers": [
                        "^com\\.splashtop\\.stb\\.macosx$",
                        "^com\\.parallels\\.desktop",
                        "^com\\.parallels\\.vm",
                        "^com\\.parallels\\.winapp\\."
                    ],
                    "type": "frontmost_application_if"
                }
            ],
            "from": {
                "key_code": "right_control",
                "modifiers": { "optional": ["any"] }
            },
            "to": [{ "key_code": "right_control" }],
            "type": "basic"
        },
